{
  "manifest_version": 3,
  "name": "Resume ↔ JD Matcher",
  "version": "2.0.0",
  "description": "Score any job description against your resumes with a transparent, factor-based match score, and autofill applications with a smart, self-learning autofill — no AI required for autofill, full match emails sent automatically.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity",
    "webNavigation"
  ],

  "host_permissions": [
    "https://openrouter.ai/*",
    "https://*.supabase.co/*",
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Resume ↔ JD Matcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["detect_application.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
