{
  "manifest_version": 3,
  "name": "Job Fit Check",
  "version": "2.4.0",
  "description": "Tap the on-page logo for full Match, Autofill, Resumes, and History. Toolbar popup is overview only.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity",
    "webNavigation"
  ],

  "host_permissions": [
    "https://openrouter.ai/*",
    "https://*.supabase.co/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*",
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Fit Check",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page_widget.js"],
      "css": ["page_widget.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["icons/jfc-logo.png", "icons/icon128.png"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:;"
  }
}
