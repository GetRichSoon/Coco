{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": { "api/nova.js": { "maxDuration": 60 } },
  "rewrites": [
    {
      "source": "/rest/v1/:path*",
      "destination": "/api/nova?__path=rest/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/nova?__path=api/:path*"
    }
  ],
  "regions": [
    "bom1"
  ]
}
