{
  "_": "The company's visual identity, in one file, so the four clients cannot drift apart.",
  "_why": "The phone app had real hand-made marks in Brand.kt - a colour pair, a Material symbol and a set of morphing shapes per house and helper - while the Lounge drew generic lettermarks. Same company, two faces. These are those exact marks, lifted value for value, plus new ones in the same language for the parts that never had one. Android keeps a copy in Brand.kt; both read from this list, and neither invents a mark at build time.",
  "_rule": "A mark is written down, never generated fresh. The derived ones at the bottom are a deterministic fallback for the long tail (sub-teams, categories, agents), and they are stable because they are keyed on the thing's own id.",
  "palette": {
    "cream": "#FFF4E6",
    "paper": "#FBF8EB",
    "ink": "#2B1712",
    "cocoa": "#5A2E1E",
    "tomato": "#F24E1E",
    "tomatoDeep": "#B83A12",
    "bubblegum": "#FFC2E2",
    "cherry": "#C21D5F",
    "sky": "#A9DCFF",
    "cobalt": "#2F55C4",
    "plum": "#4A1430",
    "wine": "#7A1838",
    "forest": "#1F5A3A",
    "butter": "#FFE79A",
    "marigold": "#EAB04A"
  },
  "_shapes": "96 polar radii each, generated by the same formulas the phone uses, so an outline is identical on both. wave(k,depth,phase): 1-depth*(0.5+0.5*cos(t*k+phase)). lobes(k,depth): 1-depth*|sin(t*k/2)|^1.6.",
  "shapes": {
    "cookie": {
      "fn": "wave",
      "k": 12,
      "depth": 0.13
    },
    "flower": {
      "fn": "lobes",
      "k": 6,
      "depth": 0.17
    },
    "clover": {
      "fn": "lobes",
      "k": 4,
      "depth": 0.25
    },
    "sunny": {
      "fn": "wave",
      "k": 8,
      "depth": 0.2
    },
    "burst": {
      "fn": "wave",
      "k": 12,
      "depth": 0.33
    },
    "soft": {
      "fn": "wave",
      "k": 10,
      "depth": 0.2,
      "phase": 0.3
    },
    "wavy": {
      "fn": "wave",
      "k": 16,
      "depth": 0.09
    },
    "blob": {
      "fn": "blob"
    },
    "circle": {
      "fn": "circle"
    }
  },
