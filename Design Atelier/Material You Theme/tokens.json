{
  "id": "material-you",
  "name": "Material You Design Theme",
  "version": "1.0.0",
  "status": "default",
  "since": "2026-10-14",
  "source": "Founder mood board Themes-1-001.zip (193 images, style only). See THEME.md.",
  "palette": {
    "cream":      { "hex": "#FFF4E6", "note": "page background, the warm paper every board sits on" },
    "paper":      { "hex": "#FBF8EB", "note": "lighter card stock" },
    "ink":        { "hex": "#2B1712", "note": "warm near-black brown, all body text" },
    "cocoa":      { "hex": "#5A2E1E", "note": "secondary text, brown duo blocks" },
    "tomato":     { "hex": "#F24E1E", "note": "signature hot orange, big surfaces + display type" },
    "tomatoDeep": { "hex": "#B83A12", "note": "tomato that passes AA for buttons and links" },
    "bubblegum":  { "hex": "#FFC2E2", "note": "soft pink fills and stickers" },
    "cherry":     { "hex": "#C21D5F", "note": "hot pink accent, AA on cream" },
    "sky":        { "hex": "#A9DCFF", "note": "baby blue fills" },
    "cobalt":     { "hex": "#2F55C4", "note": "bold blue blocks and links" },
    "plum":       { "hex": "#4A1430", "note": "deep plum / oxblood, dark blocks and dark mode base" },
    "wine":       { "hex": "#7A1838", "note": "wine red duo blocks" },
    "forest":     { "hex": "#1F5A3A", "note": "deep green duo blocks" },
    "butter":     { "hex": "#FFE79A", "note": "butter yellow fills" },
    "marigold":   { "hex": "#EAB04A", "note": "warm yellow, sticker accents" }
  },
  "duos": [
    { "id": "tomato-cream",   "bg": "tomato",   "fg": "cream",     "use": "hero, primary banners" },
    { "id": "tomato-ink",     "bg": "tomato",   "fg": "ink",       "use": "hero with small text" },
    { "id": "plum-bubblegum", "bg": "plum",     "fg": "bubblegum", "use": "night / premium blocks" },
    { "id": "cobalt-sky",     "bg": "cobalt",   "fg": "sky",       "use": "info, feature blocks" },
    { "id": "forest-butter",  "bg": "forest",   "fg": "butter",    "use": "success, calm blocks" },
    { "id": "wine-marigold",  "bg": "wine",     "fg": "marigold",  "use": "pro / pricing" },
    { "id": "cocoa-cream",    "bg": "cocoa",    "fg": "cream",     "use": "footer, quiet blocks" },
    { "id": "bubblegum-plum", "bg": "bubblegum","fg": "plum",      "use": "stickers, tags" },
    { "id": "sky-cobalt",     "bg": "sky",      "fg": "ink",       "use": "light info cards" },
    { "id": "butter-cocoa",   "bg": "butter",   "fg": "cocoa",     "use": "notes, highlights" }
  ],
  "light": {
    "primary": "#B83A12", "onPrimary": "#FFF4E6", "primaryContainer": "#FFD9C8", "onPrimaryContainer": "#3D1000",
    "secondary": "#A3245A", "onSecondary": "#FFF4E6", "secondaryContainer": "#FFD8E8", "onSecondaryContainer": "#3E0020",
    "tertiary": "#2F55C4", "onTertiary": "#FFF4E6", "tertiaryContainer": "#D3E7FF", "onTertiaryContainer": "#001A40",
    "error": "#BA1A1A", "onError": "#FFF4E6", "errorContainer": "#FFDAD6", "onErrorContainer": "#410002",
    "success": "#1F5A3A", "onSuccess": "#FFF4E6", "successContainer": "#CDEFD3", "onSuccessContainer": "#002111",
    "warning": "#7A4A00", "onWarning": "#FFF4E6", "warningContainer": "#FFE79A", "onWarningContainer": "#2A1800",
    "background": "#FFF4E6", "onBackground": "#2B1712",
    "surface": "#FFF4E6", "onSurface": "#2B1712",
    "surfaceVariant": "#F3DED0", "onSurfaceVariant": "#5A4136",
    "surfaceContainerLowest": "#FFFBF6", "surfaceContainerLow": "#FFEFDF", "surfaceContainer": "#FBE8D6",
    "surfaceContainerHigh": "#F5E1CE", "surfaceContainerHighest": "#EFDAC6",
    "outline": "#8C7164", "outlineVariant": "#DFC3B5",
    "inverseSurface": "#3A2A23", "inverseOnSurface": "#FFEDE2", "inversePrimary": "#FFB59A",
    "scrim": "#1A0B07", "shadow": "#3D1F12"
  },
  "dark": {
    "primary": "#FFA383", "onPrimary": "#5A1A00", "primaryContainer": "#8A2A08", "onPrimaryContainer": "#FFDBCF",
    "secondary": "#FFB0CF", "onSecondary": "#5E1133", "secondaryContainer": "#7E2A4C", "onSecondaryContainer": "#FFD8E8",
    "tertiary": "#A9C8FF", "onTertiary": "#002F65", "tertiaryContainer": "#22468F", "onTertiaryContainer": "#D7E3FF",
    "error": "#FFB4AB", "onError": "#690005", "errorContainer": "#93000A", "onErrorContainer": "#FFDAD6",
    "success": "#9FD8B0", "onSuccess": "#00391D", "successContainer": "#1F5A3A", "onSuccessContainer": "#CDEFD3",
    "warning": "#F5C26B", "onWarning": "#432B00", "warningContainer": "#5F3F00", "onWarningContainer": "#FFE79A",
    "background": "#1E0F14", "onBackground": "#F6E3DA",
    "surface": "#1E0F14", "onSurface": "#F6E3DA",
    "surfaceVariant": "#54363F", "onSurfaceVariant": "#DCC0C8",
    "surfaceContainerLowest": "#170A0F", "surfaceContainerLow": "#26141A", "surfaceContainer": "#2C181F",
    "surfaceContainerHigh": "#37222A", "surfaceContainerHighest": "#432C34",
    "outline": "#A68A93", "outlineVariant": "#54363F",
    "inverseSurface": "#F6E3DA", "inverseOnSurface": "#3A2A23", "inversePrimary": "#B83A12",
    "scrim": "#000000", "shadow": "#000000"
  },
  "contrastPairs": [
    ["primary", "onPrimary", 4.5], ["primaryContainer", "onPrimaryContainer", 4.5],
    ["secondary", "onSecondary", 4.5], ["secondaryContainer", "onSecondaryContainer", 4.5],
    ["tertiary", "onTertiary", 4.5], ["tertiaryContainer", "onTertiaryContainer", 4.5],
    ["error", "onError", 4.5], ["errorContainer", "onErrorContainer", 4.5],
    ["success", "onSuccess", 4.5], ["successContainer", "onSuccessContainer", 4.5],
    ["warning", "onWarning", 4.5], ["warningContainer", "onWarningContainer", 4.5],
    ["surface", "onSurface", 4.5], ["surface", "onSurfaceVariant", 4.5],
    ["surfaceContainerHighest", "onSurface", 4.5], ["surfaceContainerHighest", "onSurfaceVariant", 4.5],
    ["surface", "primary", 4.5], ["surface", "secondary", 4.5], ["surface", "tertiary", 4.5],
    ["surface", "outline", 3], ["inverseSurface", "inverseOnSurface", 4.5]
  ],
  "duoMinContrast": 3,
  "typography": {
    "display": { "family": "Fraunces", "file": "Fraunces-Variable.woff2", "ttf": "Fraunces.ttf", "fallback": "'Cooper Black', Georgia, serif",
                 "settings": "\"SOFT\" 100, \"WONK\" 1, \"opsz\" 30", "weight": 900, "note": "soft chunky retro serif: logos, headlines, palette names" },
    "fun":     { "family": "Bagel Fat One", "file": "BagelFatOne-Regular.woff2", "ttf": "BagelFatOne-Regular.ttf", "fallback": "'Arial Rounded MT Bold', system-ui, sans-serif",
                 "weight": 400, "note": "bubbly sticker type: ONE word per screen max (badge, logo, splash)" },
    "body":    { "family": "Figtree", "file": "Figtree-Variable.woff2", "ttf": "Figtree.ttf", "fallback": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
                 "weight": 450, "note": "friendly geometric sans for all UI and body text" },
    "mono":    { "family": "ui-monospace", "fallback": "'Cascadia Code', 'JetBrains Mono', Consolas, monospace", "note": "hex codes, keys, numbers" },
    "scale": {
      "displayLarge":  { "size": 56, "line": 1.05, "weight": 900, "font": "display", "tracking": -0.02 },
      "displayMedium": { "size": 40, "line": 1.1,  "weight": 900, "font": "display", "tracking": -0.015 },
      "displaySmall":  { "size": 32, "line": 1.15, "weight": 850, "font": "display", "tracking": -0.01 },
      "headlineLarge": { "size": 28, "line": 1.2,  "weight": 700, "font": "display", "tracking": 0 },
      "headlineMedium":{ "size": 24, "line": 1.25, "weight": 700, "font": "display", "tracking": 0 },
      "titleLarge":    { "size": 20, "line": 1.3,  "weight": 700, "font": "body", "tracking": 0 },
      "titleMedium":   { "size": 16, "line": 1.4,  "weight": 650, "font": "body", "tracking": 0.005 },
      "bodyLarge":     { "size": 16, "line": 1.5,  "weight": 450, "font": "body", "tracking": 0 },
      "bodyMedium":    { "size": 14, "line": 1.5,  "weight": 450, "font": "body", "tracking": 0.005 },
      "labelLarge":    { "size": 14, "line": 1.3,  "weight": 700, "font": "body", "tracking": 0.01 },
      "labelSmall":    { "size": 12, "line": 1.3,  "weight": 650, "font": "body", "tracking": 0.02 }
    }
  },
  "shape": {
    "philosophy": "round",
    "none": 0, "xs": 6, "sm": 10, "md": 16, "lg": 24, "xl": 32, "xxl": 44, "full": 999,
    "components": { "button": "full", "chip": "full", "card": "lg", "paletteCard": "xl", "dialog": "xl", "sheet": "xl", "field": "md", "fab": "lg", "popup": "lg" },
    "library": ["cookie", "flower", "clover", "sunny", "burst", "soft-burst", "pill-blob", "wavy-circle", "circle"]
  },
  "spacing": [0, 4, 8, 12, 16, 24, 32, 48, 64, 96, 128],
  "elevation": {
    "light": [
      "none",
      "0 1px 2px rgba(61,31,18,.10), 0 1px 3px rgba(61,31,18,.06)",
      "0 2px 6px rgba(61,31,18,.10), 0 4px 12px rgba(61,31,18,.06)",
      "0 4px 10px rgba(61,31,18,.10), 0 10px 24px rgba(61,31,18,.08)",
      "0 8px 18px rgba(61,31,18,.12), 0 18px 40px rgba(61,31,18,.10)"
    ],
    "darkSurfaceStep": ["surface", "surfaceContainerLow", "surfaceContainer", "surfaceContainerHigh", "surfaceContainerHighest"],
    "sticker": "0 3px 0 rgba(43,23,18,.9)"
  },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320, "short": 150, "medium": 300, "long": 500, "extraLong": 800 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasizedDecelerate": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "emphasizedAccelerate": "cubic-bezier(0.3, 0, 0.8, 0.15)",
      "loop": "cubic-bezier(0.45, 0, 0.55, 1)"
    },
    "spring": { "stiffness": 380, "damping": 0.62, "note": "bouncy expressive spring for press/select delight only" },
    "loops": {
      "morph":   { "period": 9000,  "note": "shape morph cookie > flower > clover > sunny > circle" },
      "spin":    { "period": 24000, "note": "scalloped badges rotate slowly" },
      "float":   { "period": 6000,  "amplitude": 8, "note": "stickers bob up and down" },
      "wobble":  { "period": 4000,  "degrees": 4, "note": "stickers tilt" },
      "blob":    { "period": 12000, "note": "organic border-radius blob" },
      "breathe": { "period": 3200,  "scale": 1.04, "note": "primary FAB / CTA" },
      "drift":   { "period": 22000, "note": "soft colour blobs drifting behind content" },
      "marquee": { "period": 18000, "note": "text band scroll" },
      "squiggle":{ "period": 2400,  "note": "wavy line flow" },
      "duo":     { "period": 16000, "note": "background cycles through brand duos" }
    },
    "rules": [
      "Max 3 looping things visible at once; content never loops, only decoration and the one CTA.",
      "Loops are slow (>= 2.4 s) and soft; nothing flashes faster than 3 times per second.",
      "prefers-reduced-motion: every loop stops, transitions become fades of 120 ms.",
      "Loops pause when the tab/app is hidden (CSS does this; Flutter/Compose use lifecycle)."
    ]
  }
}
