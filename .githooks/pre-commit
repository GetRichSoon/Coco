#!/usr/bin/env bash
# Refuses a commit that would add a credential-shaped value: a Supabase JWT (any role), sb_secret_,
# a connection string with a password, cloud/API keys, private keys. The memory folder is pushed to
# GitHub nightly, which is how a service_role key got committed on 2026-10-25. Enable once per clone:
#   git config core.hooksPath .githooks
pat='eyJhbGciOi[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}|sb_secret_[A-Za-z0-9_-]{10,}|postgres(ql)?://[^ "'"'"'`]*:[^ "'"'"'`@]*@|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{30,}|sk-(ant-|proj-)[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY|K00[0-9a-zA-Z]{20,}'
bad=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  case "$f" in *.png|*.jpg|*.jar|*.bin|*.dex|*.class|*.apk|*.xml|*.model|*.css) continue;; esac
  if git show ":$f" | grep -qE "$pat"; then
    if git show ":$f" | grep -E "$pat" | grep -qvE 'example:not-a-password|\[eyJ'; then echo "pre-commit: credential-shaped value in $f (not shown). Keep secrets in Coco Vault, not in git."; bad=1; fi
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)
exit $bad
